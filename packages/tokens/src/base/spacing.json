{
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale. Base unit is md (16px); every step is divisible by 4. Use for padding, margin and gap.",
    "2xs": { "$value": { "value": 4, "unit": "px" }, "$description": "0.25× base. Icon-to-text gaps, tight inline spacing." },
    "xs": { "$value": { "value": 8, "unit": "px" }, "$description": "0.5× base. Gaps inside compact controls, between related items." },
    "sm": { "$value": { "value": 12, "unit": "px" }, "$description": "0.75× base. Control padding, list item gaps." },
    "md": { "$value": { "value": 16, "unit": "px" }, "$description": "1× base unit. Default padding and gap." },
    "lg": { "$value": { "value": 24, "unit": "px" }, "$description": "1.5× base. Card padding, form field groups." },
    "xl": { "$value": { "value": 32, "unit": "px" }, "$description": "2× base. Section padding on mobile." },
    "2xl": { "$value": { "value": 48, "unit": "px" }, "$description": "3× base. Gaps between page sections." },
    "3xl": { "$value": { "value": 64, "unit": "px" }, "$description": "4× base. Section padding on desktop." },
    "4xl": { "$value": { "value": 96, "unit": "px" }, "$description": "6× base. Hero / landing spacing." },
    "5xl": { "$value": { "value": 128, "unit": "px" }, "$description": "8× base. Largest layout spacing." }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Heights for buttons, inputs, selects.",
      "sm": { "$value": { "value": 32, "unit": "px" }, "$description": "Dense desktop UIs only. Pad the hit area to 44px on touch." },
      "md": { "$value": { "value": 40, "unit": "px" } },
      "lg": { "$value": { "value": 48, "unit": "px" }, "$description": "Default for touch-first / mobile layouts." }
    },
    "touchTarget": {
      "min": { "$value": { "value": 44, "unit": "px" }, "$description": "Minimum interactive target on touch devices (WCAG 2.5.5 AAA / Apple HIG; exceeds 2.5.8 AA 24px)." }
    },
    "icon": {
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 20, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } },
      "xl": { "$value": { "value": 32, "unit": "px" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "xl": { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": { "value": 1, "unit": "px" } },
      "thick": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "focus": {
    "$type": "dimension",
    "width": { "$value": { "value": 2, "unit": "px" }, "$description": "Focus ring thickness (WCAG 2.4.7 / 2.4.11)." },
    "offset": { "$value": { "value": 2, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Mobile-first min-width breakpoints.",
    "sm": { "$value": { "value": 640, "unit": "px" } },
    "md": { "$value": { "value": 768, "unit": "px" } },
    "lg": { "$value": { "value": 1024, "unit": "px" } },
    "xl": { "$value": { "value": 1280, "unit": "px" } },
    "2xl": { "$value": { "value": 1536, "unit": "px" } }
  }
}
