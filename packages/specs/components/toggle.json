      { "code": ["hideLabel"], "figma": "showLabel", "figmaType": "BOOLEAN", "figmaDefault": true, "status": "differs", "note": "Inverted: hideLabel = !showLabel." },
      { "code": ["description"], "figma": "description", "figmaType": "TEXT", "figmaDefault": "Get alerts when a match starts.", "status": "aligned", "note": "Needs showDescription on." },
      { "code": [], "figma": "showDescription", "figmaType": "BOOLEAN", "figmaDefault": false, "status": "figma-only", "note": "Visibility toggle for description." },
      { "code": ["checked"], "figma": "checked", "figmaType": "VARIANT", "figmaValues": ["false", "true"], "figmaDefault": "false", "status": "differs", "note": "Same name, different values. Code checked is a boolean; Figma uses the strings false and true." },
      { "code": ["defaultChecked"], "status": "code-only", "note": "Starting value for an uncontrolled toggle. Figma has no controlled / uncontrolled split." },
      { "code": ["onCheckedChange"], "status": "code-only", "note": "Behaviour." },
      { "code": ["size"], "figma": "size", "figmaType": "VARIANT", "figmaValues": ["md", "sm"], "figmaDefault": "md", "status": "aligned", "note": "Same values and default. Web only; native has one size." },
      { "code": ["labelPosition"], "status": "code-only", "note": "Not modelled. Figma always puts the label after the track, which is the web default; native defaults to start." },
      { "code": ["disabled"], "figma": "state=disabled", "figmaType": "VARIANT", "status": "differs", "note": "disabled=true in code is state=disabled in Figma." },
      { "code": [], "figma": "state", "figmaType": "VARIANT", "figmaValues": ["default", "hover", "focus", "disabled"], "figmaDefault": "default", "status": "differs", "note": "Figma-only axis for specs and prototypes. focus is :focus-visible." }
