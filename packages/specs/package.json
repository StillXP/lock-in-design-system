{
  "name": "@lockin/specs",
  "version": "0.1.0",
  "description": "AI-readable JSON specs for every Lock In component (props, states, tokens, accessibility, usage).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": "./components/*",
    "./schema": "./schema/component.schema.json",
    "./validate": {
      "types": "./scripts/validate.d.ts",
      "default": "./scripts/validate.mjs"
    }
  },
  "files": [
    "dist",
    "components",
    "schema"
  ],
  "scripts": {
    "build": "node scripts/validate.mjs --build",
    "validate": "node scripts/validate.mjs",
    "check:code": "node scripts/check-code.mjs",
    "test": "node --test test/check-code.test.mjs"
  },
  "dependencies": {
    "@lockin/tokens": "0.1.0",
    "ajv": "^8.17.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
