{
  "name": "@lockin/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook workbench for Lock In: every component, token group and icon, with spec-driven docs and axe checks.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build": "storybook build -o storybook-static",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lockin/icons": "0.1.0",
    "@lockin/react": "0.1.0",
    "@lockin/specs": "0.1.0",
    "@lockin/tokens": "0.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
