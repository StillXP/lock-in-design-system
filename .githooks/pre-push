#!/bin/sh
# Blocks pushes to main and force pushes, for people and any AI agent (see AGENTS.md, "Git workflow").
# Enabled by `npm install` (the root "prepare" script sets core.hooksPath to .githooks).
# Branch protection on GitHub is the real gate; this catches mistakes before they leave the machine.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Blocked: do not push to ${remote_ref#refs/heads/}. Push a branch and open a pull request." >&2
      status=1
      continue
      ;;
  esac
  # Deleting a branch, or creating a new one: nothing to overwrite.
  [ "$local_sha" = "$zero" ] && continue
  [ "$remote_sha" = "$zero" ] && continue
  # Non-fast-forward (the remote tip isn't in what we push, or we don't even have it) means a force push.
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "Blocked: force push to ${remote_ref#refs/heads/}. Ask the repo owner if one is really needed." >&2
    status=1
  fi
done
exit $status
